{
  "ConnectionStrings": {
    "BookSpace": "Server=(localdb)\\MSSQLLocalDB;Database=BookSpace;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Auth": {
    "Issuer": "BookSpace",
    "Audience": "BookSpace",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
