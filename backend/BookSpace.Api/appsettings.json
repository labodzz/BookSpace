{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BackgroundJobs": {
    "Enabled": false,
    "PollIntervalSeconds": 30,
    "LeaseDurationSeconds": 60,
    "HeartbeatIntervalSeconds": 20,
    "BatchSize": 50,
    "MaxNotificationAttempts": 5,
    "InitialRetryDelaySeconds": 60,
    "MaxRetryDelaySeconds": 3600,
    "Reminder": {
      "Enabled": false,
      "LeadTimeMinutes": 60,
      "BatchSize": 50
    },
    "StaleApproval": {
      "Enabled": false,
      "BatchSize": 50
    },
    "NoShow": {
      "Enabled": false,
      "BatchSize": 50
    }
  },
  "Email": {
    "Enabled": false,
    "Provider": "Smtp",
    "FromAddress": "",
    "FromName": "BookSpace",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Security": "StartTls"
    }
  }
}
