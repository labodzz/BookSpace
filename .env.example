# Copy this file to `.env` (untracked - see .gitignore) and fill in real local values before running:
#   podman compose -f compose.local.yaml up --build -d
#
# These are LOCAL-ONLY values for compose.local.yaml. Nothing here is used in Azure - Azure Container
# Apps configuration/secrets are documented separately in docs/container-deployment.md.

# SQL Server 2022 container's "sa" password. Must satisfy SQL Server's own complexity policy (8+
# characters, at least three of: upper case, lower case, digit, symbol).
DB_SA_PASSWORD=Ch4ngeThisLocalPassword!

# JWT signing key for the local container - any long random string. Not the same key used in
# Development via `dotnet user-secrets` or in a real deployment.
AUTH_SIGNING_KEY=local-container-signing-key-change-me-please-make-it-long

# Gmail SMTP sender - see docs/background-jobs.md ("Gmail SMTP sender") for the full setup, including the
# manual, one-time Google Account step (enable 2-Step Verification, then generate an App Password) this
# requires - there is nothing here to automate. Leave Email__Enabled=false (the default) to run locally
# without any of this configured at all; the app and the automated test suite both work with zero SMTP
# credentials when it's false. Email__Smtp__Password is a 16-character Gmail App Password, never your
# real Google account password - these are placeholders only, never real values.
Email__Enabled=false
Email__Provider=Smtp
Email__FromAddress=bookspace.sender@gmail.com
Email__FromName=BookSpace
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__Security=StartTls
Email__Smtp__Username=bookspace.sender@gmail.com
Email__Smtp__Password=replace-with-a-gmail-app-password
