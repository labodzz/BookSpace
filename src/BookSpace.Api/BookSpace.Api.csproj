    <Folder Include="Infrastructure\Identity\" />
    <Folder Include="Infrastructure\Persistence\" />
    <Folder Include="Middlewares\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookSpace.Application\BookSpace.Application.csproj" />
    <ProjectReference Include="..\BookSpace.Infrastructure\BookSpace.Infrastructure.csproj" />
  </ItemGroup>

</Project>
