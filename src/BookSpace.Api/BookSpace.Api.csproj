    <UserSecretsId>e1900e3c-20b0-4c8e-89c0-80da60ead426</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
