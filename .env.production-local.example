# Copy this file to `.env.production-local` (untracked - see .gitignore/.dockerignore) and fill in real
# local values before running:
#   podman compose --env-file .env.production-local -f compose.production-local.yaml up --build -d
#
# These are LOCAL-ONLY values for compose.production-local.yaml - a smoke test of the PRODUCTION startup
# path (ASPNETCORE_ENVIRONMENT=Production) on this laptop, before pushing the image to Docker Hub via
# GitHub Actions and deploying to AWS ECS. Nothing here is a real deployment secret - see
# docs/container-deployment.md for the actual Azure/production secrets list and naming.

# SQL Server 2022 container's "sa" password (this compose project's own local test database only - never
# shared with compose.local.yaml's bookspace-db). Must satisfy SQL Server's own complexity policy (8+
# characters, at least three of: upper case, lower case, digit, symbol).
DB_SA_PASSWORD=Ch4ngeThisLocalPassword!

# JWT signing key (Auth:SigningKey) for this local container - any long random string. Use a DIFFERENT
# value than compose.local.yaml's own AUTH_SIGNING_KEY or a real deployment's key; a token signed by one
# must never validate against another.
AUTH_SIGNING_KEY=replace-with-a-long-random-production-like-signing-key

# --- First global SysAdmin bootstrap (ProductionBootstrapper / Bootstrap:*) ---
# See docs/container-deployment.md ("Production bootstrap"). Idempotent across restarts - a user with
# Bootstrap__SysAdminEmail already existing means a previous run already completed; it will NOT create a
# second SysAdmin or reset this password. After you have logged in once as this account, set
# Bootstrap__Enabled=false below and re-run `up -d` (no rebuild needed) to turn bootstrap back off.
Bootstrap__Enabled=true
Bootstrap__SysAdminFirstName=Sys
Bootstrap__SysAdminLastName=Admin
Bootstrap__SysAdminEmail=sysadmin@bookspace.local
# Required when Bootstrap__Enabled=true - ProductionBootstrapper fails startup loudly if this is missing.
# Never the same password you use anywhere real.
Bootstrap__SysAdminPassword=ChangeThisLocalPassword!1

# --- Gmail SMTP sender (optional) - see docs/background-jobs.md ("Gmail SMTP sender") ---
# Leave Email__Enabled=false (the default) to test the full create-tenant/invitation flow WITHOUT sending
# any real email - the invitation link still lands in the NotificationOutboxItems table/container logs,
# exactly like compose.local.yaml. Only set this to true, with a real Gmail App Password (never your real
# Google account password), if you specifically want to verify real SMTP delivery before deploying.
Email__Enabled=false
Email__Provider=Smtp
Email__FromAddress=bookspace.sender@gmail.com
Email__FromName=BookSpace
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__Security=StartTls
Email__Smtp__Username=bookspace.sender@gmail.com
Email__Smtp__Password=replace-with-a-gmail-app-password
